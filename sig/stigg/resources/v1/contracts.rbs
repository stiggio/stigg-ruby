module Stigg
  module Resources
    class V1
      class Contracts
        def create: (
          customer_id: String,
          subscriptions: ::Array[Stigg::V1::ContractCreateParams::Subscription],
          ?activation_end_date: Time,
          ?activation_start_date: Time,
          ?name: String?,
          ?po_number: String?,
          ?setup_billing: bool,
          ?x_account_id: String,
          ?x_environment_id: String,
          ?request_options: Stigg::request_opts
        ) -> Stigg::Models::V1::ContractCreateResponse

        def retrieve: (
          String id,
          ?x_account_id: String,
          ?x_environment_id: String,
          ?request_options: Stigg::request_opts
        ) -> Stigg::Models::V1::ContractRetrieveResponse

        def update: (
          String id,
          ?activation_end_date: Time,
          ?activation_start_date: Time,
          ?name: String?,
          ?po_number: String?,
          ?setup_billing: bool,
          ?subscription_ids: ::Array[String],
          ?x_account_id: String,
          ?x_environment_id: String,
          ?request_options: Stigg::request_opts
        ) -> Stigg::Models::V1::ContractUpdateResponse

        def list: (
          ?after: String,
          ?before: String,
          ?customer_external_id: String,
          ?limit: Integer,
          ?name: String,
          ?state: String,
          ?x_account_id: String,
          ?x_environment_id: String,
          ?request_options: Stigg::request_opts
        ) -> Stigg::Internal::MyCursorIDPage[Stigg::Models::V1::ContractListResponse]

        def delete: (
          String id,
          ?x_account_id: String,
          ?x_environment_id: String,
          ?request_options: Stigg::request_opts
        ) -> Stigg::Models::V1::ContractDeleteResponse

        def initialize: (client: Stigg::Client) -> void
      end
    end
  end
end
