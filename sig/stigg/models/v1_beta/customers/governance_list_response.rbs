module Stigg
  module Models
    module V1Beta
      module Customers
        type governance_list_response =
          {
            cadence: String?,
            current_usage: Float?,
            display_name: String?,
            entity_id: String,
            entity_type_id: String,
            parent_id: String?,
            scope_entity_ids: ::Array[String],
            usage_limit: Float?,
            usage_period_end: Time?,
            usage_period_start: Time?,
            utilization: Float?,
            currency_id: String,
            feature_id: String
          }

        class GovernanceListResponse < Stigg::Internal::Type::BaseModel
          attr_accessor cadence: String?

          attr_accessor current_usage: Float?

          attr_accessor display_name: String?

          attr_accessor entity_id: String

          attr_accessor entity_type_id: String

          attr_accessor parent_id: String?

          attr_accessor scope_entity_ids: ::Array[String]

          attr_accessor usage_limit: Float?

          attr_accessor usage_period_end: Time?

          attr_accessor usage_period_start: Time?

          attr_accessor utilization: Float?

          attr_reader currency_id: String?

          def currency_id=: (String) -> String

          attr_reader feature_id: String?

          def feature_id=: (String) -> String

          def initialize: (
            cadence: String?,
            current_usage: Float?,
            display_name: String?,
            entity_id: String,
            entity_type_id: String,
            parent_id: String?,
            scope_entity_ids: ::Array[String],
            usage_limit: Float?,
            usage_period_end: Time?,
            usage_period_start: Time?,
            utilization: Float?,
            ?currency_id: String,
            ?feature_id: String
          ) -> void

          def to_hash: -> {
            cadence: String?,
            current_usage: Float?,
            display_name: String?,
            entity_id: String,
            entity_type_id: String,
            parent_id: String?,
            scope_entity_ids: ::Array[String],
            usage_limit: Float?,
            usage_period_end: Time?,
            usage_period_start: Time?,
            utilization: Float?,
            currency_id: String,
            feature_id: String
          }
        end
      end
    end
  end
end
