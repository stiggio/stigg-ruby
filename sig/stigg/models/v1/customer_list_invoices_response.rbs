module Stigg
  module Models
    module V1
      type customer_list_invoices_response =
        {
          contract_external_id: String?,
          currency: String?,
          customer_external_id: String?,
          discount: Float?,
          due_date: Time?,
          invoice_external_id: String?,
          invoice_id: String,
